+/**
+ * CPython's positional-arity TypeError, message and all, or `undefined` when
+ * the count is right.
+ *
+ * Five details below were measured against CPython 3.14 rather than recalled,
+ * and each is a way the obvious string is wrong: the count and the noun
+ * pluralise independently; two missing names join with `and` while three or
+ * more take an Oxford comma; a method is named `Class.method`; and a method's
+ * two counts INCLUDE the bound `self` the caller never wrote, so
+ * `C().m(1, 2)` against `def m(self, y)` reports 2 taken and 3 given.
+ *
+ * An exact length comparison is safe here because EML parameters are plain
+ * identifiers — the grammar parses `params` as `Identifier[]` with no default
+ * values, no `*args` and no `**kwargs` — so there is no legal call shape whose
+ * argument count may differ from its parameter count.
+ */
+function arityError(
+  label: string,
+  params: FunctionDef['params'],
+  argc: number,
+  boundSelf: number,
+): PyError | undefined {
+  if (argc === params.length) return undefined;
+  if (argc < params.length) {
+    const missing = params.slice(argc).map((p) => `'${p.name}'`);
+    const names =
+      missing.length === 1
+        ? missing[0]!
+        : missing.length === 2
+          ? `${missing[0]} and ${missing[1]}`
+          : `${missing.slice(0, -1).join(', ')}, and ${missing[missing.length - 1]}`;
+    return new PyError(
+      'TypeError',
+      `${label}() missing ${missing.length} required positional argument${
+        missing.length === 1 ? '' : 's'
+      }: ${names}`,
+    );
+  }
+  const takes = params.length + boundSelf;
+  const given = argc + boundSelf;
+  return new PyError(
+    'TypeError',
+    `${label}() takes ${takes} positional argument${takes === 1 ? '' : 's'} but ${given} ${
+      given === 1 ? 'was' : 'were'
+    } given`,
+  );
+}
