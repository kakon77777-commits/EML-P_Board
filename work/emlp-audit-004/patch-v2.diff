+/**
+ * EMLP-AUDIT-004 — binder x legal-reference resolution identity.
+ *
+ * A name bound in a CLASS BODY lands in the class namespace. It is read two
+ * ways, and both must reach the same binding:
+ *
+ *   inside the class body   as a bare name      `mirror = list`
+ *   outside the class       as an attribute     `c.list`
+ *
+ * Attribute access is never aliased, so neither half of a class-namespace name
+ * may be aliased either — binder *or* bare read. Aliasing only one side is what
+ * v1 of this fix did, and it turned a self-consistent (if oddly spelled) class
+ * into `list = 5` followed by `mirror = lst`, a NameError at class definition.
+ *
+ * Everywhere else the ordinary alias policy still applies, including inside a
+ * method: a `def` opens a normal local scope again.
+ *
+ * The rule is NOT "never alias inside a class". It is "a class-namespace name
+ * is spelled the same in every position", so a bare read of a MODULE-level
+ * name from inside a class body still aliases normally.
+ */
+type ScopeFrame = { kind: 'class'; names: Set<string> } | { kind: 'function' };
+
+const scopeStack: ScopeFrame[] = [];
+
+/** True when `name` is bound in the innermost enclosing CLASS body. */
+function isClassNamespaceName(name: string): boolean {
+  const top = scopeStack[scopeStack.length - 1];
+  return top !== undefined && top.kind === 'class' && top.names.has(name);
+}
+
+/** Emit an identifier in binder or read position, honouring class namespaces. */
+function emitName(name: string): string {
+  return isClassNamespaceName(name) ? name : aliasIdentifier(name);
+}
+
+/**
+ * Names bound directly in a class body, including inside nested `if`/`while`/
+ * `for`/`with`/`try` blocks, which bind into the same class namespace.
+ *
+ * A `def` or nested `class` binds ITS OWN NAME as a class attribute, but its
+ * body is a separate scope and is not descended into.
+ */
+function collectClassBindings(body: readonly Statement[], out: Set<string>): void {
+  for (const st of body) {
+    switch (st.type) {
+      case 'Assignment':
+      case 'AugmentedAssign':
+        if (st.target.type === 'Identifier') out.add(st.target.name);
+        break;
+      case 'ForIn':
+        out.add(st.target.name);
+        collectClassBindings(st.body, out);
+        break;
+      case 'With':
+        if (st.target) out.add(st.target.name);
+        collectClassBindings(st.body, out);
+        break;
+      case 'Try':
+        collectClassBindings(st.body, out);
+        for (const h of st.handlers) {
+          if (h.name) out.add(h.name);
+          collectClassBindings(h.body, out);
+        }
+        collectClassBindings(st.finallyBody, out);
+        break;
+      case 'If':
+        collectClassBindings(st.body, out);
+        collectClassBindings(st.orelse, out);
+        break;
+      case 'While':
+        collectClassBindings(st.body, out);
+        break;
+      case 'FunctionDef':
+      case 'ClassDef':
+        // the name is a class attribute; the body is its own scope
+        out.add(st.name);
+        break;
+      default:
+        break;
+    }
+  }
+}
