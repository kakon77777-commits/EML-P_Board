+    expect(readFileSync(ledger, 'utf8'), 'the committed ledger moved').toBe(committedLedgerAtLoad);
+    expect(readFileSync(baselineFile, 'utf8'), 'the committed baseline moved').toBe(committedBaselineAtLoad);
+  });
+});
